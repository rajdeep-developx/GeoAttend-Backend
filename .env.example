# Server
PORT=5000
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:5173

# PostgreSQL (configure your own local database credentials)
DATABASE_URL=your_database_url_here
PGHOST=localhost
PGPORT=5432
PGUSER=your_db_user
PGPASSWORD=your_db_password
PGDATABASE=your_db_name

# JWT
JWT_SECRET=replace_with_a_long_random_string
JWT_EXPIRES_IN=7d

# Email (SMTP - configure your own email provider)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_app_password
EMAIL_FROM="GeoAttend <no-reply@geoattend.app>"

# Geo-fence
DEFAULT_GEOFENCE_RADIUS_METERS=120
LOW_ATTENDANCE_THRESHOLD_PERCENT=75

# OTP login
OTP_EXPIRY_MINUTES=10
COLLEGE_EMAIL_DOMAIN=kiit.ac.in